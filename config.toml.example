[capture]
interface = "en0"
snap_len = 96
promiscuous = false

[filter]
exclude_networks = ["127.0.0.0/8", "169.254.0.0/16", "172.17.0.0/16", "172.18.0.0/16"]
local_networks = ["10.0.0.0/8", "192.168.0.0/16"]

[storage]
db_path = "~/.network-tracker/data.db"
retention_1s = "1h"
retention_1m = "7d"
retention_1h = "90d"

[web]
listen = "127.0.0.1:8787"
